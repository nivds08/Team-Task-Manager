<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Team Task Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="app-body">
    <div id="appLoading" class="app-loading" aria-live="polite">
      <div class="spinner" aria-hidden="true"></div>
      <p>Loading your workspace…</p>
    </div>

    <div id="toastHost" class="toast-host" aria-live="polite"></div>

    <div id="appShell" class="app-shell" hidden>
      <aside class="app-sidebar">
        <a class="brand" href="/">
          <span class="brand-mark">◆</span>
          <span class="brand-text">Ethara<span class="brand-muted">Tasks</span></span>
        </a>

        <div class="user-card">
          <div class="user-avatar" id="userAvatar" aria-hidden="true"></div>
          <div class="user-meta">
            <div class="user-email" id="userEmail"></div>
            <span class="role-pill" id="userRole"></span>
          </div>
        </div>

        <nav class="side-nav" aria-label="Primary">
          <button type="button" class="side-nav-btn is-active" data-tab="overview">Dashboard</button>
          <button type="button" class="side-nav-btn" data-tab="projects">Projects &amp; teams</button>
        </nav>

        <section id="adminSection" class="admin-stack" hidden>
          <div class="side-card">
            <h3>New project</h3>
            <p class="hint">Admins can create projects and grow the team.</p>
            <form id="projectForm" class="stack-form">
              <label class="field">
                <span>Name</span>
                <input type="text" name="name" required minlength="3" maxlength="120" placeholder="e.g. Mobile launch" />
              </label>
              <label class="field">
                <span>Description</span>
                <textarea name="description" rows="2" maxlength="1000" placeholder="Optional context"></textarea>
              </label>
              <button class="btn btn-primary btn-block" type="submit">Create project</button>
            </form>
          </div>

          <div class="side-card">
            <h3>New task</h3>
            <p class="hint">Assign work to someone on the project team.</p>
            <form id="taskForm" class="stack-form">
              <label class="field">
                <span>Title</span>
                <input type="text" name="title" required minlength="3" maxlength="200" placeholder="Short, actionable title" />
              </label>
              <label class="field">
                <span>Details</span>
                <textarea name="description" rows="2" maxlength="1500" placeholder="Acceptance criteria, links…"></textarea>
              </label>
              <label class="field">
                <span>Project</span>
                <select name="projectId" id="projectSelect" required></select>
              </label>
              <label class="field">
                <span>Assignee</span>
                <select name="assignedTo" id="assignSelect" required disabled></select>
              </label>
              <div class="field-row">
                <label class="field">
                  <span>Status</span>
                  <select name="status">
                    <option value="todo">Todo</option>
                    <option value="in_progress">In progress</option>
                    <option value="done">Done</option>
                  </select>
                </label>
                <label class="field">
                  <span>Due date</span>
                  <input type="date" name="dueDate" />
                </label>
              </div>
              <button class="btn btn-primary btn-block" type="submit">Create task</button>
            </form>
          </div>
        </section>

        <button type="button" class="btn btn-ghost btn-block" id="logoutBtn">Log out</button>
      </aside>

      <main class="app-main">
        <header class="main-header">
          <div>
            <h1 class="page-title" id="pageHeading">Dashboard</h1>
            <p class="page-sub" id="pageSub">Track workload, deadlines, and ownership in one place.</p>
          </div>
        </header>

        <div id="messageBanner" class="banner" hidden role="status"></div>

        <section class="panel is-active" data-panel="overview">
          <div class="stats-row">
            <button type="button" class="stat-card is-active" data-stat-filter="all">
              <span class="stat-label">All tasks</span>
              <span class="stat-value" id="summaryTotal">—</span>
              <span class="stat-hint">Click to clear filters</span>
            </button>
            <button type="button" class="stat-card" data-stat-filter="todo">
              <span class="stat-label">Todo</span>
              <span class="stat-value" id="summaryTodo">—</span>
            </button>
            <button type="button" class="stat-card" data-stat-filter="in_progress">
              <span class="stat-label">In progress</span>
              <span class="stat-value" id="summaryProgress">—</span>
            </button>
            <button type="button" class="stat-card" data-stat-filter="done">
              <span class="stat-label">Done</span>
              <span class="stat-value" id="summaryDone">—</span>
            </button>
            <button type="button" class="stat-card stat-card-warn" data-stat-filter="overdue">
              <span class="stat-label">Overdue</span>
              <span class="stat-value" id="summaryOverdue">—</span>
            </button>
          </div>

          <div class="toolbar">
            <label class="search-field">
              <span class="sr-only">Search tasks</span>
              <input type="search" id="taskSearch" placeholder="Search by title, project, or assignee…" autocomplete="off" />
            </label>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Task</th>
                  <th>Project</th>
                  <th>Assignee</th>
                  <th>Due</th>
                  <th>Status</th>
                  <th>Update</th>
                </tr>
              </thead>
              <tbody id="taskTableBody"></tbody>
            </table>
          </div>
        </section>

        <section class="panel" data-panel="projects">
          <h2 class="section-title">Projects &amp; teams</h2>
          <p class="section-lead">Every project lists its collaborators. Admins can invite others by user ID.</p>
          <div id="projectsGrid" class="projects-grid"></div>
        </section>
      </main>
    </div>

    <script src="/js/app.js" defer></script>
  </body>
</html>
