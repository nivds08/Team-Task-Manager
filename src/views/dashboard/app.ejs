<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="container">
      <div class="header-row">
        <h1>Project Dashboard</h1>
        <button class="btn secondary" id="logoutBtn">Logout</button>
      </div>
      <p id="userInfo"></p>

      <section class="grid">
        <div class="card">
          <h3>Summary</h3>
          <ul id="summaryList"></ul>
        </div>

        <div class="card" id="projectCreateCard">
          <h3>Create Project (Admin)</h3>
          <form id="projectForm">
            <label>Project Name <input type="text" name="name" required /></label>
            <label>Description <textarea name="description"></textarea></label>
            <button class="btn" type="submit">Create Project</button>
          </form>
        </div>

        <div class="card" id="taskCreateCard">
          <h3>Create Task (Admin)</h3>
          <form id="taskForm">
            <label>Title <input type="text" name="title" required /></label>
            <label>Description <textarea name="description"></textarea></label>
            <label>Project <select name="projectId" id="projectSelect" required></select></label>
            <label>Assign User ID <input type="number" min="1" name="assignedTo" required /></label>
            <label>Status
              <select name="status">
                <option value="todo">Todo</option>
                <option value="in_progress">In Progress</option>
                <option value="done">Done</option>
              </select>
            </label>
            <label>Due Date <input type="date" name="dueDate" /></label>
            <button class="btn" type="submit">Create Task</button>
          </form>
        </div>
      </section>

      <section class="card">
        <h3>Projects</h3>
        <ul id="projectsList"></ul>
      </section>

      <section class="card">
        <h3>Tasks</h3>
        <ul id="tasksList"></ul>
      </section>
      <p id="message"></p>
    </main>

    <script>
      const message = document.getElementById("message");
      let currentUser = null;

      async function api(url, options = {}) {
        const response = await fetch(url, {
          ...options,
          headers: { "Content-Type": "application/json", ...(options.headers || {}) },
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || "Request failed");
        return data;
      }

      async function init() {
        try {
          const me = await api("/api/auth/me");
          currentUser = me.user;
          document.getElementById("userInfo").textContent = `Logged in as ${currentUser.email} (${currentUser.role}) - User ID: ${currentUser.id}`;
          if (currentUser.role !== "admin") {
            document.getElementById("projectCreateCard").style.display = "none";
            document.getElementById("taskCreateCard").style.display = "none";
          }
          await Promise.all([loadDashboard(), loadProjects(), loadTasks()]);
        } catch (error) {
          window.location.href = "/login";
        }
      }

      async function loadDashboard() {
        const data = await api("/api/dashboard");
        const summaryList = document.getElementById("summaryList");
        summaryList.innerHTML = Object.entries(data.summary)
          .map(([k, v]) => `<li><strong>${k}</strong>: ${v}</li>`)
          .join("");
      }

      async function loadProjects() {
        const projects = await api("/api/projects");
        const projectsList = document.getElementById("projectsList");
        const select = document.getElementById("projectSelect");
        projectsList.innerHTML = projects
          .map((p) => `<li><strong>${p.name}</strong> - ${p.description || "No description"} (Team: ${p.teamMembers.length})</li>`)
          .join("");
        select.innerHTML = projects.map((p) => `<option value="${p.id}">${p.name}</option>`).join("");
      }

      async function loadTasks() {
        const tasks = await api("/api/tasks");
        const tasksList = document.getElementById("tasksList");
        tasksList.innerHTML = tasks
          .map(
            (t) => `
          <li>
            <strong>${t.title}</strong> - ${t.status} | Project: ${t.project?.name || "N/A"} | Assigned: ${t.assignedTo?.email || "N/A"}
            <select data-task-id="${t.id}">
              <option value="todo" ${t.status === "todo" ? "selected" : ""}>Todo</option>
              <option value="in_progress" ${t.status === "in_progress" ? "selected" : ""}>In Progress</option>
              <option value="done" ${t.status === "done" ? "selected" : ""}>Done</option>
            </select>
          </li>`
          )
          .join("");

        document.querySelectorAll("#tasksList select").forEach((el) => {
          el.addEventListener("change", async (e) => {
            try {
              await api(`/api/tasks/${e.target.dataset.taskId}/status`, {
                method: "PATCH",
                body: JSON.stringify({ status: e.target.value }),
              });
              await loadDashboard();
            } catch (error) {
              message.textContent = error.message;
            }
          });
        });
      }

      document.getElementById("projectForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const payload = Object.fromEntries(new FormData(e.target).entries());
        try {
          await api("/api/projects", { method: "POST", body: JSON.stringify(payload) });
          e.target.reset();
          await loadProjects();
        } catch (error) {
          message.textContent = error.message;
        }
      });

      document.getElementById("taskForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const payload = Object.fromEntries(new FormData(e.target).entries());
        try {
          await api("/api/tasks", { method: "POST", body: JSON.stringify(payload) });
          e.target.reset();
          await Promise.all([loadTasks(), loadDashboard()]);
        } catch (error) {
          message.textContent = error.message;
        }
      });

      document.getElementById("logoutBtn").addEventListener("click", async () => {
        await api("/api/auth/logout", { method: "POST" });
        window.location.href = "/login";
      });

      init();
    </script>
  </body>
</html>
